# Copy to .env on the server only. NEVER commit a filled .env.
# The API key lives only in the server's secret store / environment.
MODEL_API_KEY=
# Budget safeguard kill switch: set to 1 to reject all model calls.
CCC_KILL_SWITCH=0
# Live transport stays disabled until the Founder separately authorizes live calls.
CCC_LIVE_AUTHORIZED=0
